{
  "files": {
    "includes": ["**", "!node_modules", "!dist", "!skill", "!.claude", "!bun.lock"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "json": {
    "formatter": {
      "expand": "auto"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["camelCase"]
          }
        },
        "noParameterAssign": "error",
        "useConst": "error"
      },
      "complexity": {
        "useArrowFunction": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error"
      },
      "nursery": {
        "useExplicitType": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["tests/**", "scripts/**"],
      "linter": {
        "rules": {
          "nursery": {
            "useExplicitType": "off"
          }
        }
      }
    }
  ]
}
